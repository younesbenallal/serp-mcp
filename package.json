{
  "name": "serp-mcp",
  "version": "0.1.0",
  "description": "MCP server that reads Google results pages through a background Chrome on your own machine and returns them as JSON.",
  "type": "module",
  "bin": {
    "serp-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "search": "bun src/index.ts search",
    "open": "bun src/index.ts open",
    "stop": "bun src/index.ts stop",
    "typecheck": "tsc --noEmit",
    "inspect": "bunx @modelcontextprotocol/inspector bun src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
